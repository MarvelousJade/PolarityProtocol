.interface-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(228, 241, 246);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.is-hidden {
    display: none;
}

.gameplay-screen {
    color: white;
}

.hud-panel,
.intro-card,
.modal-card {
    background-color: rgba(5, 15, 25, 0.82);
    border-left-width: 4px;
    border-left-color: rgba(82, 204, 235, 0.86);
}

.objective-panel {
    position: absolute;
    left: 48px;
    top: 42px;
    width: 570px;
    height: 130px;
    padding-left: 27px;
    padding-right: 24px;
    padding-top: 10px;
    padding-bottom: 12px;
}

.hud-heading {
    color: white;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    height: 50px;
}

.panel-rule {
    height: 3px;
    width: 100%;
    margin-bottom: 7px;
}

.panel-rule-push {
    background-color: rgb(244, 75, 87);
}

.objective-copy {
    color: rgb(189, 219, 228);
    font-size: 18px;
    white-space: normal;
    flex-grow: 1;
}

.encounter-summary {
    position: absolute;
    left: 760px;
    top: 44px;
    width: 400px;
    height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    color: white;
    background-color: rgba(5, 15, 25, 0.72);
    border-bottom-width: 3px;
    border-bottom-color: rgb(53, 213, 236);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.health-panel {
    position: absolute;
    left: 48px;
    bottom: 50px;
    width: 570px;
    height: 120px;
    padding-left: 27px;
    padding-right: 38px;
    padding-top: 12px;
    padding-bottom: 18px;
    border-top-width: 3px;
    border-top-color: rgb(244, 75, 87);
}

.eyebrow,
.micro-copy,
.footer-copy,
.gameplay-hint,
.navigation-hint {
    color: rgb(184, 219, 228);
    font-size: 13px;
    -unity-font-style: bold;
}

.eyebrow {
    height: 30px;
    font-size: 18px;
    -unity-text-align: middle-left;
}

.ability-panel {
    position: absolute;
    right: 50px;
    bottom: 50px;
    width: 585px;
    height: 174px;
    padding-left: 28px;
    padding-right: 40px;
    padding-top: 10px;
    padding-bottom: 17px;
    border-top-width: 3px;
    border-top-color: rgb(53, 213, 236);
}

.ability-panel.polarity-push {
    border-left-color: rgb(244, 75, 87);
    border-top-color: rgb(244, 75, 87);
}

.ability-header {
    height: 53px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ability-header .hud-heading {
    flex-grow: 1;
}

.micro-copy {
    width: 180px;
    height: 30px;
    -unity-text-align: middle-right;
}

.cooldown-row {
    height: 34px;
    margin-top: 8px;
    flex-direction: row;
    justify-content: space-between;
}

.status-host {
    flex-shrink: 0;
}

.status-host-large {
    height: 30px;
}

.status-host-energy {
    height: 25px;
}

.status-host-small {
    width: 48%;
    height: 16px;
}

.status-bar,
.status-bar-template {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.status-track {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.11);
    overflow: hidden;
}

.status-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.status-fill-pull {
    background-color: rgb(53, 213, 236);
}

.status-fill-push {
    background-color: rgb(244, 75, 87);
}

.status-fill-neutral {
    background-color: rgb(230, 239, 243);
}

.status-label,
.status-value {
    position: absolute;
    left: 8px;
    top: 0;
    right: 8px;
    bottom: 0;
    color: rgb(7, 20, 29);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.status-value {
    -unity-text-align: middle-right;
}

.status-host-small .status-label,
.status-host-small .status-value {
    font-size: 10px;
}

.damage-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-left-width: 105px;
    border-right-width: 105px;
    border-top-width: 105px;
    border-bottom-width: 105px;
    border-left-color: rgba(244, 75, 87, 0.48);
    border-right-color: rgba(244, 75, 87, 0.48);
    border-top-color: rgba(244, 75, 87, 0.48);
    border-bottom-color: rgba(244, 75, 87, 0.48);
    opacity: 0;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54px;
    height: 54px;
    margin-left: -27px;
    margin-top: -27px;
}

.crosshair-line,
.crosshair-dot {
    position: absolute;
    background-color: rgb(53, 213, 236);
}

.crosshair.polarity-push .crosshair-line,
.crosshair.polarity-push .crosshair-dot {
    background-color: rgb(244, 75, 87);
}

.crosshair-left {
    left: 0;
    top: 26px;
    width: 12px;
    height: 2px;
}

.crosshair-right {
    right: 0;
    top: 26px;
    width: 12px;
    height: 2px;
}

.crosshair-top {
    left: 26px;
    top: 0;
    width: 2px;
    height: 12px;
}

.crosshair-bottom {
    left: 26px;
    bottom: 0;
    width: 2px;
    height: 12px;
}

.crosshair-dot {
    left: 24px;
    top: 24px;
    width: 6px;
    height: 6px;
    background-color: white;
}

.gameplay-hint {
    position: absolute;
    left: 580px;
    bottom: 0;
    width: 760px;
    height: 38px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(5, 15, 25, 0.72);
    border-top-width: 2px;
    border-top-color: rgba(82, 204, 235, 0.72);
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.intro-screen {
    background-color: rgba(3, 9, 17, 0.94);
    align-items: center;
    justify-content: center;
}

.polarity-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 18px;
}

.polarity-rail-pull {
    left: 0;
    background-color: rgb(53, 213, 236);
}

.polarity-rail-push {
    right: 0;
    background-color: rgb(244, 75, 87);
}

.intro-content {
    width: 1090px;
    align-items: center;
}

.display-title,
.modal-title {
    color: white;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.display-title {
    width: 100%;
    height: 100px;
}

.display-subtitle,
.outcome-subtitle {
    color: white;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.display-subtitle {
    width: 100%;
    height: 60px;
    margin-bottom: 30px;
}

.intro-card {
    width: 100%;
    height: 320px;
    padding-left: 58px;
    padding-right: 58px;
    padding-top: 35px;
    padding-bottom: 30px;
    border-top-width: 3px;
    border-top-color: rgb(53, 213, 236);
    border-bottom-width: 3px;
    border-bottom-color: rgb(244, 75, 87);
}

.intro-copy {
    height: 95px;
    color: rgb(210, 230, 237);
    font-size: 21px;
    white-space: normal;
}

.controls-row {
    flex-grow: 1;
    flex-direction: row;
}

.control-column {
    flex-grow: 1;
    width: 48%;
}

.control-divider {
    width: 1px;
    margin-left: 30px;
    margin-right: 30px;
    background-color: rgba(82, 204, 235, 0.28);
}

.control-title {
    height: 31px;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
}

.control-copy {
    flex-grow: 1;
    color: rgb(189, 219, 228);
    font-size: 17px;
    white-space: normal;
}

.action-button {
    height: 70px;
    color: rgb(230, 242, 246);
    background-color: rgba(12, 34, 49, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(108, 151, 165);
    border-right-color: rgb(108, 151, 165);
    border-top-color: rgb(108, 151, 165);
    border-bottom-color: rgb(108, 151, 165);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.action-button:hover {
    color: rgb(53, 213, 236);
    background-color: rgb(235, 243, 246);
    border-left-color: white;
    border-right-color: white;
    border-top-color: white;
    border-bottom-color: white;
}

.action-button:active {
    color: rgb(244, 75, 87);
}

.action-button:focus,
.action-button.is-selected {
    color: rgb(5, 17, 25);
    background-color: white;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(53, 213, 236);
    border-right-color: rgb(53, 213, 236);
    border-top-color: rgb(53, 213, 236);
    border-bottom-color: rgb(53, 213, 236);
}

.action-button-primary {
    width: 500px;
    margin-top: 55px;
}

.action-button-secondary {
    width: 450px;
    height: 58px;
    margin-top: 18px;
}

.footer-copy {
    width: 850px;
    height: 40px;
    margin-top: 28px;
    -unity-text-align: middle-center;
}

.modal-screen {
    background-color: rgba(0, 0, 0, 0.62);
    align-items: center;
    justify-content: center;
}

.modal-card {
    width: 680px;
    min-height: 500px;
    padding-left: 80px;
    padding-right: 80px;
    padding-top: 50px;
    padding-bottom: 34px;
    align-items: center;
    border-left-width: 0;
}

.modal-accent {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 10px;
}

.modal-accent-pull {
    background-color: rgb(53, 213, 236);
}

.modal-accent-push {
    background-color: rgb(244, 75, 87);
}

.modal-title {
    width: 100%;
    height: 80px;
}

.modal-copy {
    width: 450px;
    height: 90px;
    margin-top: 35px;
    color: rgb(210, 230, 237);
    font-size: 21px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.pause-card .action-button-primary {
    width: 450px;
    margin-top: 30px;
}

.navigation-hint {
    width: 100%;
    height: 30px;
    margin-top: 23px;
    -unity-text-align: middle-center;
}

.outcome-screen {
    background-color: rgba(3, 8, 15, 0.84);
}

.outcome-card {
    width: 860px;
    height: 720px;
    padding-left: 150px;
    padding-right: 150px;
    padding-top: 55px;
    padding-bottom: 30px;
}

.outcome-subtitle {
    width: 100%;
    height: 45px;
    margin-top: 10px;
    font-size: 22px;
}

.metric-list {
    width: 100%;
    margin-top: 35px;
}

.metric-row {
    height: 65px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(184, 219, 228, 0.17);
}

.metric-name,
.metric-value {
    color: rgb(189, 219, 228);
    font-size: 18px;
    -unity-font-style: bold;
}

.metric-name {
    flex-grow: 1;
}

.metric-value {
    width: 220px;
    color: white;
    font-size: 25px;
    -unity-text-align: middle-right;
}

.metric-score {
    height: 80px;
    border-bottom-width: 0;
}

.metric-score-name {
    color: white;
    font-size: 25px;
}

.metric-score-value {
    font-size: 40px;
}

.outcome-card .action-button-primary {
    width: 480px;
    height: 72px;
    margin-top: 25px;
}

.outcome-card .navigation-hint {
    margin-top: 14px;
}

